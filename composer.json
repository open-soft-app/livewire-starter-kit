{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "tallstackui/starter-kit",
    "type": "project",
    "description": "My Starter Kit for Laravel 13.",
    "keywords": [
        "laravel",
        "framework",
        "tallstackui"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Roberto Otupacca",
            "email": "otupacca@yahoo.it"
        }
    ],
    "require": {
        "php": "^8.2",
        "laravel/fortify": "^1.30",
        "laravel/framework": "^13.0",
        "laravel/tinker": "^3.0",
        "livewire/livewire": "^4.0.0",
        "spatie/laravel-permission": "^8.3",
        "tallstackui/tallstackui": "^4.0"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^4.0",
        "fakerphp/faker": "^1.23",
        "kitloong/laravel-migrations-generator": "^7.4",
        "larastan/larastan": "^3.1",
        "laravel-lang/common": "^6.8",
        "laravel/boost": "^2.2",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.21",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^5.2",
        "pestphp/pest-plugin-laravel": "^5.0",
        "pestphp/pest-plugin-type-coverage": "^5.0",
        "reliese/laravel": "^1.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/helper.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan boost:update --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi",
            "@php artisan db:seed",
            "@composer update"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"npm run dev\" --names='server,queue,vite'"
        ],
        "format": "./vendor/bin/pint --parallel",
        "analyse": "./vendor/bin/phpstan analyse --memory-limit=2G",
        "test": "./vendor/bin/pest --parallel",
        "type": "./vendor/bin/pest --type-coverage --min=100 --compact",
        "ci": [
            "Composer\\Config::disableProcessTimeout",
            "./vendor/bin/pint --test --parallel",
            "./vendor/bin/pest --type-coverage --min=100 --compact",
            "./vendor/bin/phpstan analyse --memory-limit=2G",
            "./vendor/bin/pest --parallel --tia"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
